{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/checklist.mjs sync 2>/dev/null || true",
            "statusMessage": "기능 체크리스트 동기화 중...",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *ERP_기능_체크리스트.json) node scripts/checklist.mjs sync 2>/dev/null || true;; esac",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
